{
  "$schema": "https://opencode.ai/config.schema.json",
  "name": "SmartServe",
  "version": "1.0.0",
  "description": "SmartServe AI Home-Services Platform with OpenCode & OpenRouter AI Model Gateway",
  "agent": {
    "provider": "openrouter",
    "apiKeyEnv": "OPENROUTER_API_KEY",
    "modelEnv": "OPENROUTER_MODEL",
    "defaultModel": "openrouter/ox-alpha",
    "fallbackModels": [
      "openrouter/mimo-v2.5",
      "anthropic/claude-3.5-sonnet",
      "google/gemini-2.5-pro"
    ],
    "temperature": 0.2,
    "maxTokens": 4096
  },
  "database": {
    "provider": "postgresql",
    "connectionEnv": "DATABASE_URL",
    "modelsPath": "backend/app/models",
    "migrationsPath": "backend/alembic"
  },
  "environment": {
    "ide": "Antigravity",
    "agent": "OpenCode",
    "gateway": "OpenRouter"
  }
}
